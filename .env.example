# Public — safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=https://www.starnovalabs.com

# Server only — never prefix these with NEXT_PUBLIC_.
# Added in Batch 2 with the contact route handler.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@starnovalabs.com

# Address messages are sent from. Must be on a Resend-verified domain.
CONTACT_FROM_EMAIL="StarNova Labs Website <website@starnovalabs.com>"
