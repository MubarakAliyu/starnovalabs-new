# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# StarNova additions
.env*
!.env.example
.vercel
.next
node_modules
*.log
.DS_Store
scaffold-tmp

# Raw asset drops — curated copies live in public/images and public/video,
# listed in docs/assets/image-manifest.json. Keep the originals out of git:
# they are large, unoptimised and carry EXIF the curated set has stripped.
/public/Little Coders!/
/public/new-logo/
/public/images/*.heic
/public/*.heic
/public/*.jpeg
/public/IMG-*.jpg
/public/IMG_*.jpg

# Confidential: the deck carries the raise, valuation and unit economics.
# It lives at docs/reference/ so it is not served, and stays out of git so it
# cannot leak through the repository either. git add -f it if that changes.
/public/*.pdf
/docs/reference/*.pdf

# Local verification screenshots.
/.shots/

# QA screenshots are a working artefact, not part of the project.
/docs/qa/*
!/docs/qa/README.md
# Throwaway Chrome profiles used by the QA scripts.
/.chrome-*/

# Raw owner-supplied photography, straight off a phone. These carry EXIF/GPS and
# must never be committed: import them through sharp into public/images/** with
# the metadata stripped, then delete the original.
/public/CEO.jpg

# QA audit output, regenerated by npm run audit:a11y.
.a11y-report.json
